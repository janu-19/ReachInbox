datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  picture   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  emails    Email[]
}

enum EmailStatus {
  SCHEDULED
  SENDING
  SENT
  FAILED
}

model Email {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderEmail   String
  recipient     String
  subject       String
  body          String      @db.Text
  scheduledTime DateTime
  sentTime      DateTime?
  status        EmailStatus @default(SCHEDULED)
  error         String?     @db.Text
  jobId         String?     @unique // BullMQ Job ID mapping for potential cancel/reschedule
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([scheduledTime])
}
